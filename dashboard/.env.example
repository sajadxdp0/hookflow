# Server-side only. Never prefix these with NEXT_PUBLIC_ — that would inline
# credentials into the browser bundle.
HOOKFLOW_API_URL=http://localhost:8000
HOOKFLOW_API_KEY=hf_<prefix>_<secret>

# development (default) or production. Production requires DASHBOARD_PASSWORD.
HOOKFLOW_ENVIRONMENT=development

# HTTP Basic access gate. TLS is mandatory outside local development.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password

# Optional: both values are required to list and revoke tenant API keys.
HOOKFLOW_ADMIN_TOKEN=
HOOKFLOW_TENANT_ID=
