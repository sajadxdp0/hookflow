# Copy to .env (do NOT commit .env)
HOOKFLOW_ENVIRONMENT=development
DATABASE_URL=sqlite:///./hookflow.db
# Production: postgresql+psycopg://hookflow:change-me@localhost:5432/hookflow
REDIS_URL=
# Production: redis://localhost:6379/0

# Symmetric key protecting webhook secrets at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty uses a published development key and is rejected by /ready in production.
SECRET_ENCRYPTION_KEY=

# Admin API credential (ADMIN_TOKEN is also accepted as an alias).
# Empty disables /v1/admin with 503. Generate with: openssl rand -hex 32
HOOKFLOW_ADMIN_TOKEN=

# Tenant abuse controls.
INGEST_RATE_LIMIT_PER_MINUTE=600
MAX_ENDPOINTS_PER_TENANT=100

# Worker tuning. The lease must exceed the delivery timeout.
DELIVERY_TIMEOUT_SECONDS=10
CLAIM_LEASE_SECONDS=60
MAX_ATTEMPTS=5
BACKOFF_SCHEDULE_SECONDS=[60,300,1800,7200,43200]

# Optional dashboard Compose profile. The password is mandatory in production;
# the dashboard fails closed when it is absent. Terminate TLS before exposing it.
HOOKFLOW_API_URL=http://app:8000
HOOKFLOW_API_KEY=
HOOKFLOW_TENANT_ID=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
